{
  "metadata": {
    "name": "MadOS Sakura",
    "revision": "1"
  },
  "editor-colors": {
    "BackgroundColor": "#FDF3F8",
    "BracketMatching": "#F9A8D4",
    "CodeFolding": "#FBDCEB",
    "CurrentLine": "#FCE4F0",
    "CurrentLineNumber": "#B02A5A",
    "IconBorder": "#FBDCEB",
    "IndentationLine": "#F0C4D8",
    "LineNumbers": "#C083A3",
    "MarkBookmark": "#EC4899",
    "MarkBreakpointActive": "#EC4899",
    "MarkBreakpointDisabled": "#C083A3",
    "MarkError": "#E11D48",
    "MarkExecution": "#F9A8D4",
    "MarkWarning": "#D97706",
    "ModifiedLine": "#F472B6",
    "ReplaceHighlight": "#F9A8D4",
    "SavedLine": "#FBDCEB",
    "SearchHighlight": "#FDE68A",
    "Selection": "#FBCFE8",
    "Separator": "#F0C4D8",
    "Spacer": "#F0C4D8",
    "TabMarker": "#F0C4D8",
    "TemplateBackground": "#FCE4F0",
    "TemplateFocusedPlaceholder": "#F9A8D4",
    "TemplatePlaceholder": "#FBDCEB",
    "TextSelection": "#FBCFE8",
    "WordWrapMarker": "#F0C4D8"
  },
  "text-styles": {
    "Normal": { "foreground": "#5D3446" },
    "Keyword": { "foreground": "#B02A5A", "bold": true },
    "DataType": { "foreground": "#9333EA" },
    "DecVal": { "foreground": "#D97706" },
    "BaseN": { "foreground": "#D97706" },
    "Float": { "foreground": "#D97706" },
    "Constant": { "foreground": "#DB2777" },
    "Char": { "foreground": "#DB2777" },
    "SpecialChar": { "foreground": "#DB2777" },
    "String": { "foreground": "#4D7C0F" },
    "VerbatimString": { "foreground": "#4D7C0F" },
    "SpecialString": { "foreground": "#4D7C0F" },
    "Comment": { "foreground": "#C083A3", "italic": true },
    "Documentation": { "foreground": "#C083A3", "italic": true },
    "Function": { "foreground": "#7E22CE" },
    "Operator": { "foreground": "#5D3446" },
    "Alert": { "foreground": "#E11D48", "bold": true },
    "Error": { "foreground": "#E11D48", "bold": true },
    "Warning": { "foreground": "#D97706" },
    "Information": { "foreground": "#7A3A58" },
    "Import": { "foreground": "#9333EA" },
    "ControlFlow": { "foreground": "#B02A5A", "bold": true },
    "Extension": { "foreground": "#7E22CE" },
    "Preprocessor": { "foreground": "#DB2777" },
    "Attribute": { "foreground": "#9333EA" },
    "RegionMarker": { "foreground": "#EC4899" },
    "BuiltIn": { "foreground": "#7E22CE" },
    "Variable": { "foreground": "#5D3446" },
    "Others": { "foreground": "#5D3446" }
  }
}
